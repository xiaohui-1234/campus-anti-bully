.device-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
  border: 1rpx solid #eef3f2;
}

.device-main {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.device-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 23rpx;
  background: #eef4f2;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.device-icon.online {
  background: #e7f4ed;
}

.device-icon image {
  width: 39rpx;
  height: 39rpx;
}

.device-body {
  flex: 1;
  min-width: 0;
}

.device-name {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d2b2f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-id {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c8b8d;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status {
  min-width: 88rpx;
  height: 44rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: #eef4f2;
  color: #6f7f82;
  flex: 0 0 auto;
}

.status.online {
  background: #e7f4ed;
  color: #2f7d57;
}

.device-meta {
  margin-top: 22rpx;
  display: flex;
  justify-content: space-between;
  color: #7c8b8d;
  font-size: 24rpx;
  gap: 20rpx;
}

.device-note,
.device-time {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.device-note image,
.device-time image {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 auto;
}

.device-note text,
.device-time text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.device-note {
  flex: 1;
}

.device-time {
  flex: 0 1 auto;
  text-align: right;
}
