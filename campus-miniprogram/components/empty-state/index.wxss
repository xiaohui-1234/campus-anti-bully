.empty {
  padding: 72rpx 32rpx;
  text-align: center;
  color: #7c8b8d;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(33, 54, 59, 0.04);
  border: 1rpx solid #edf2ef;
}

.empty-title {
  font-size: 30rpx;
  color: #46575a;
  font-weight: 700;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.empty-action {
  min-width: 200rpx;
  height: 72rpx;
  margin: 28rpx auto 0;
  padding: 0 28rpx;
  border-radius: 22rpx;
  background: #e8f4f3;
  color: #0f8b8d;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}
