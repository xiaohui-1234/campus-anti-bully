.event-card {
  background: #ffffff;
  border-radius: 28rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
  border: 1rpx solid #eef3f2;
  overflow: hidden;
}

.event-body {
  padding: 26rpx 26rpx 18rpx;
}

.event-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}

.event-title-wrap {
  display: flex;
  gap: 18rpx;
  min-width: 0;
}

.event-title-main {
  min-width: 0;
}

.event-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-top: 12rpx;
  flex: 0 0 auto;
}

.event-dot.read {
  background: #39b777;
  box-shadow: 0 0 0 8rpx rgba(57, 183, 119, 0.1);
}

.event-dot.hot {
  background: #e25555;
  box-shadow: 0 0 0 8rpx rgba(226, 85, 85, 0.1);
}

.event-type {
  font-size: 30rpx;
  font-weight: 800;
  color: #1d2b2f;
  max-width: 380rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-device {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c8b8d;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.event-device text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-mini-icon {
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 auto;
}

.event-status {
  min-width: 82rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #eef4f2;
  font-size: 24rpx;
  color: #6f7f82;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.event-status.read {
  background: #eaf8f1;
  color: #259b61;
}

.event-status.unread {
  background: #fff0ee;
  color: #d84f45;
}

.event-info {
  margin-top: 22rpx;
  color: #3f5053;
  font-size: 28rpx;
  line-height: 1.55;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.event-info-icon {
  width: 30rpx;
  height: 30rpx;
  margin-top: 6rpx;
  flex: 0 0 auto;
}

.event-info text {
  min-width: 0;
  flex: 1;
}

.event-meta {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7c8b8d;
  font-size: 24rpx;
  gap: 18rpx;
}

.file-status {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.file-status.ready {
  color: #259b61;
}

.file-status.pending {
  color: #7c8b8d;
}

.event-time {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
}

.event-time text {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.event-meta-icon {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
}

.event-actions {
  border-top: 1rpx solid #edf2ef;
  padding: 16rpx 20rpx 18rpx;
  display: grid;
  grid-template-columns: 1fr 154rpx;
  gap: 12rpx;
  align-items: center;
}

.play-button,
.detail-link {
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.play-button {
  gap: 10rpx;
  background: #e8f4f3;
  color: #0f8b8d;
  position: relative;
  overflow: hidden;
}

.play-button.disabled {
  background: #f2f5f4;
  color: #9aa6a8;
}

.play-button.playing {
  background: #dff1ea;
  color: #17744c;
}

.play-progress {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 0;
  background: #9ddfc1;
  opacity: 0.72;
  transition: width 0.2s linear;
}

.play-button.disabled .play-progress {
  display: none;
}

.play-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.play-icon {
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid currentColor;
}

.play-icon.pause {
  width: 16rpx;
  height: 20rpx;
  border: 0;
  position: relative;
}

.play-icon.pause::before,
.play-icon.pause::after {
  content: '';
  position: absolute;
  top: 0;
  width: 5rpx;
  height: 20rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.play-icon.pause::before {
  left: 0;
}

.play-icon.pause::after {
  right: 0;
}

.play-icon-image {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 auto;
}

.detail-link {
  background: #f1f7f6;
  color: #58777a;
  border: 1rpx solid #e0ecea;
  gap: 9rpx;
  font-weight: 600;
}

.detail-icon-image {
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 auto;
}
