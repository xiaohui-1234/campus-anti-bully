.loading-slot {
  height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  opacity: 0;
  transition: height 0.16s ease, opacity 0.16s ease;
}

.loading-slot.is-visible {
  height: 44rpx;
  opacity: 1;
}

.loading-dots {
  display: flex;
  align-items: center;
  gap: 10rpx;
  pointer-events: none;
}

.loading-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #8fb8b5;
  animation: loading-pulse 0.9s ease-in-out infinite;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.12s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.24s;
}

@keyframes loading-pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }

  50% {
    opacity: 1;
    transform: translateY(-5rpx);
  }
}
