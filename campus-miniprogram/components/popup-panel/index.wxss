.mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.popup {
  width: 100%;
  max-height: 78vh;
  overflow: auto;
  background: #ffffff;
  border-radius: 38rpx 38rpx 0 0;
  padding: 32rpx 30rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  box-shadow: 0 -18rpx 50rpx rgba(35, 59, 65, 0.12);
}
