.agreement-page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(60rpx + env(safe-area-inset-bottom));
  background: #f5f7f6;
  box-sizing: border-box;
  color: #263238;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1d2b2f;
}

.updated {
  margin: 12rpx 0 36rpx;
  color: #7c8b8d;
  font-size: 24rpx;
}

.section-title {
  margin-top: 30rpx;
  color: #1d2b2f;
  font-size: 30rpx;
  font-weight: 700;
}

.paragraph {
  margin-top: 14rpx;
  color: #526466;
  font-size: 27rpx;
  line-height: 1.8;
}
