<wxs module="tabSwipeGesture" src="../../utils/tab-swipe.wxs" />

<view class="custom-nav" style="{{navStyle}}">
  <view class="custom-nav-title">校园防霸凌</view>
</view>

<view class="page devices-page tab-swipe-page {{tabSwipeClass}}" style="{{contentStyle}}" data-tab-index="1" data-tab-swipe-disabled="{{bindVisible || detailVisible || actionLoading}}" bindtouchstart="{{tabSwipeGesture.touchStart}}" bindtouchmove="{{tabSwipeGesture.touchMove}}" bindtouchend="{{tabSwipeGesture.touchEnd}}" bindtouchcancel="{{tabSwipeGesture.touchCancel}}">
  <view class="page-heading">
    <view class="page-title">设备</view>
    <view class="page-subtitle">管理已绑定设备，查看在线状态并维护地点备注</view>
    <image class="heading-shield" src="../../assets/icons/profile/shield-bg.png" mode="aspectFit"></image>
  </view>

  <view class="toolbar {{search_active || keyword ? 'toolbar-searching' : ''}}">
    <view class="search-bar">
      <image class="toolbar-search-icon" src="../../assets/icons/event/search-gray.png" mode="aspectFit"></image>
      <input class="search-input" placeholder="搜索设备名称、地点或编号" value="{{keyword}}" bindinput="onKeyword" bindfocus="onSearchFocus" bindblur="onSearchBlur" confirm-type="search" bindconfirm="reload" />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="clearKeyword">×</view>
    </view>
    <view class="button search-button" bindtap="reload">
      <image src="../../assets/icons/event/search-white.png" mode="aspectFit"></image>
      <text>搜索</text>
    </view>
    <view wx:if="{{!search_active && !keyword}}" class="button add-button" bindtap="openBind">
      <image src="../../assets/icons/shared/plus-white.png" mode="aspectFit"></image>
      <text>添加设备</text>
    </view>
  </view>

  <view class="section-head">
    <view class="section-title">我的设备</view>
    <view class="section-action refresh-action" bindtap="reload">
      <image src="../../assets/icons/event/refresh-teal.png" mode="aspectFit"></image>
      <text>刷新</text>
    </view>
  </view>

  <loading-view loading="{{loading && !initialized}}" />
  <block wx:if="{{devices.length}}">
    <device-card wx:for="{{devices}}" wx:key="device_id" device="{{item}}" bind:open="openDetail" />
    <view wx:if="{{hasMore}}" class="button secondary load-more" bindtap="loadMore">加载更多设备</view>
    <view wx:else class="list-end">已显示全部 {{devices.length}} 台设备</view>
  </block>
  <empty-state
    wx:elif="{{!loading || initialized}}"
    title="{{loadError ? '设备加载失败' : (keyword ? '未找到设备' : '暂无设备')}}"
    desc="{{loadError ? '请检查网络连接后重试' : (keyword ? '换个关键词，或清除搜索查看全部设备' : '输入设备编号和一次性绑定码，添加第一台设备')}}"
    action-text="{{loadError ? '重新加载' : (keyword ? '清除搜索' : '添加设备')}}"
    bind:action="handleEmptyAction"
  />

  <popup-panel visible="{{bindVisible}}" bind:close="closePanels">
    <view class="detail-handle"></view>
    <view class="detail-title">绑定设备</view>
    <view class="detail-desc">输入设备编号和一次性绑定码，绑定后即可接收报警</view>
    <input class="input form-input" placeholder="设备编号" maxlength="64" value="{{bindForm.device_id}}" bindinput="onBindDeviceId" />
    <input class="input form-input" placeholder="一次性绑定码" maxlength="32" value="{{bindForm.bind_code}}" bindinput="onBindCode" />
    <input class="input form-input" placeholder="设备名称（选填）" maxlength="50" value="{{bindForm.device_name}}" bindinput="onBindName" />
    <view class="button" bindtap="submitBind">{{actionLoading ? '绑定中...' : '确认绑定'}}</view>
  </popup-panel>

  <popup-panel visible="{{detailVisible}}" bind:close="closePanels">
    <view wx:if="{{currentDevice}}">
      <view class="detail-handle"></view>
      <view class="detail-title">{{currentDevice.device_name || currentDevice.deviceName || currentDevice.device_id}}</view>
      <view class="detail-desc">这些信息只影响当前用户看到的设备备注</view>
      <view class="detail-status-card {{(currentDevice.online_status || currentDevice.onlineStatus) === 'ONLINE' ? 'online' : 'offline'}}">
        <view class="detail-status-dot"></view>
        <view class="detail-status-copy">
          <view class="detail-status-title">{{(currentDevice.online_status || currentDevice.onlineStatus) === 'ONLINE' ? '当前在线' : '当前离线'}}</view>
          <view class="detail-status-desc">最近在线 {{currentDevice.last_online_time || currentDevice.lastOnlineTime || '暂无记录'}}</view>
        </view>
      </view>
      <input class="input form-input" placeholder="设备名称" maxlength="50" value="{{editForm.device_name}}" bindinput="onEditName" />
      <input class="input form-input" placeholder="地点" maxlength="100" value="{{editForm.location}}" bindinput="onEditLocation" />
      <input class="input form-input" placeholder="备注" maxlength="200" value="{{editForm.note}}" bindinput="onEditNote" />
      <view class="detail-actions">
        <view class="button danger" bindtap="submitUnbind">{{actionLoading ? '处理中...' : '解绑'}}</view>
        <view class="button" bindtap="submitEdit">{{actionLoading ? '保存中...' : '保存'}}</view>
      </view>
    </view>
  </popup-panel>
</view>
