.events-page {
  background:
    radial-gradient(circle at 92% 4%, rgba(185, 224, 225, 0.25), transparent 230rpx),
    #edf2f3;
}

.page-heading {
  min-height: 142rpx;
  position: relative;
  overflow: hidden;
}

.page-heading .page-title,
.page-heading .page-subtitle {
  position: relative;
  z-index: 1;
}

.heading-shield {
  position: absolute;
  width: 250rpx;
  height: 194rpx;
  right: -12rpx;
  top: -20rpx;
  opacity: 0.58;
}

.filters {
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 20rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
  border: 1rpx solid #eef3f2;
}

.filter-top {
  display: grid;
  grid-template-columns: 1fr 136rpx;
  gap: 14rpx;
  align-items: center;
}

.filter-toggle {
  height: 84rpx;
  border-radius: 18rpx;
  background: #e8f4f3;
  color: #0f8b8d;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.event-search-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
}

.filter-icon-image {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
}

.toggle-arrow {
  line-height: 1;
  transition: transform 0.16s ease;
}

.toggle-arrow.is-open {
  transform: rotate(180deg);
}

.filter-panel {
  padding-top: 18rpx;
}

.filter-grid,
.time-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.time-grid {
  margin-top: 14rpx;
}

.wide-filter {
  grid-column: span 2;
}

.filter-field,
.time-field {
  min-height: 84rpx;
  border-radius: 18rpx;
  background: #f1f6f4;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.field-name {
  color: #7c8b8d;
  font-size: 22rpx;
  line-height: 1.2;
}

.field-value,
.field-input {
  margin-top: 8rpx;
  min-width: 0;
  color: #263238;
  font-size: 26rpx;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-input {
  height: 34rpx;
}

.filter-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.filter-button {
  height: 76rpx;
  border-radius: 18rpx;
}

.query-button {
  gap: 12rpx;
}

.query-icon-image {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
}

.refresh-action {
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.refresh-icon-image {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 auto;
}

.pagination {
  margin: 32rpx 0 44rpx;
  padding: 28rpx 24rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e9eeee;
}

.pagination-nav {
  display: grid;
  grid-template-columns: 124rpx minmax(0, 1fr) 124rpx;
  gap: 18rpx;
  align-items: center;
}

.pagination-step {
  height: 68rpx;
  padding: 0 14rpx;
  border-radius: 17rpx;
  background: #ffffff;
  border: 1rpx solid #e3e9e9;
  color: #59676a;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
  flex: 0 0 auto;
}

.pagination-step-arrow {
  margin-top: -2rpx;
  font-size: 31rpx;
  line-height: 1;
}

.pagination-step.disabled {
  color: #b2bcbc;
  background: #fafbfb;
  border-color: #eef2f2;
}

.pagination-pages {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  overflow: hidden;
}

.pagination-page,
.pagination-ellipsis {
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex: 0 0 auto;
}

.pagination-page {
  min-width: 56rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: #ffffff;
  border: 1rpx solid #e5ebeb;
  color: #59676a;
  font-size: 24rpx;
  font-weight: 600;
}

.pagination-page.active {
  color: #ffffff;
  border-color: transparent;
  background: #4b9498;
}

.pagination-ellipsis {
  width: 28rpx;
  color: #98a4a6;
  font-size: 22rpx;
}

.pagination-footer {
  min-height: 82rpx;
  margin-top: 28rpx;
  padding: 24rpx 4rpx 0;
  border-top: 1rpx solid #edf2f1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.pagination-summary {
  color: #768589;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.pagination-summary text {
  color: #4b9498;
  font-weight: 800;
}

.pagination-jump {
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.pagination-jump-label {
  color: #7f8d90;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.pagination-jump-control {
  width: 106rpx;
  height: 60rpx;
  padding: 0 12rpx;
  border-radius: 15rpx;
  background: #ffffff;
  border: 1rpx solid #e3e9e9;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.pagination-input {
  width: 100%;
  height: 58rpx;
  text-align: center;
  color: #263238;
  font-size: 23rpx;
}

.pagination-input-suffix {
  color: #7f8d90;
  font-size: 24rpx;
  flex: 0 0 auto;
}

.pagination-jump-button {
  width: 94rpx;
  height: 60rpx;
  border-radius: 15rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #4b9498;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.pagination-jump-button.disabled {
  color: #aab7b7;
  background: #f1f4f3;
}

.detail-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #d6e0df;
  margin: 0 auto 24rpx;
}

.detail-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1d2b2f;
  margin-bottom: 24rpx;
}

.detail-card {
  background: #f1f6f4;
  border-radius: 22rpx;
  padding: 8rpx 22rpx;
}

.detail-line {
  font-size: 28rpx;
  color: #46575a;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 1rpx solid #dfe8e5;
}

.detail-line:last-child {
  border-bottom: 0;
}

.detail-line text:first-child {
  color: #7c8b8d;
  flex: 0 0 auto;
}

.detail-line text:last-child {
  text-align: right;
  min-width: 0;
  overflow-wrap: anywhere;
}

.detail-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 28rpx;
}
