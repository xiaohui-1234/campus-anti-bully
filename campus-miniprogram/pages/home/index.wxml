<view class="custom-nav" style="{{navStyle}}">
  <view class="custom-nav-title">校园防霸凌</view>
</view>

<view class="page home-page" style="{{contentStyle}}">
  <view class="home-header">
    <view>
      <view class="page-title">今日守护</view>
      <view class="page-subtitle">实时同步已绑定设备的报警与在线状态</view>
    </view>
    <image class="home-heading-shield" src="../../assets/icons/profile/shield-bg.png" mode="aspectFit"></image>
    <view class="header-badge"><view class="badge-dot"></view>在线 {{onlineTotal}}</view>
  </view>

  <view class="hero">
    <view>
      <view class="hero-kicker">待关注事件</view>
      <view class="hero-title">{{pendingTotal}}</view>
      <view class="hero-subtitle">新报警会自动置顶，网络恢复后自动补齐</view>
    </view>
    <view class="hero-status {{realtimeClass}}">
      <view class="pulse"></view>
      <text>{{realtimeText}}</text>
    </view>
  </view>

  <view class="summary">
    <view class="summary-item">
      <view class="summary-mark bind">
        <image src="../../assets/icons/shared/device-teal.png" mode="aspectFit"></image>
      </view>
      <view class="num">{{devices.length}}</view>
      <view class="label">已绑定</view>
    </view>
    <view class="summary-item">
      <view class="summary-mark event">
        <image src="../../assets/icons/shared/bell-red.png" mode="aspectFit"></image>
      </view>
      <view class="num">{{pendingTotal}}</view>
      <view class="label">待关注</view>
    </view>
  </view>

  <view class="quick-actions">
    <navigator url="/pages/devices/index" open-type="switchTab" class="quick-action">
      <image src="../../assets/icons/shared/device-teal.png" mode="aspectFit"></image>
      <text>管理设备</text>
    </navigator>
    <navigator url="/pages/events/index" open-type="switchTab" class="quick-action">
      <image src="../../assets/icons/shared/bell-red.png" mode="aspectFit"></image>
      <text>查看事件</text>
    </navigator>
    <navigator url="/pages/profile/index" open-type="switchTab" class="quick-action">
      <image src="../../assets/icons/shared/profile-purple.png" mode="aspectFit"></image>
      <text>个人资料</text>
    </navigator>
  </view>

  <view class="section-head">
    <view class="section-title">最新事件</view>
    <navigator url="/pages/events/index" open-type="switchTab" class="section-action">全部</navigator>
  </view>

  <loading-view loading="{{loading && !initialized}}" />
  <block wx:if="{{events.length}}">
    <event-card wx:for="{{events}}" wx:key="event_id" event="{{item}}" audio-state="{{audioState}}" bind:open="openEvent" bind:play="playAudio" />
  </block>
  <empty-state
    wx:elif="{{!loading || initialized}}"
    title="{{loadError ? '首页加载失败' : '暂无新事件'}}"
    desc="{{loadError ? '请检查网络连接后重试' : '新报警将在这里自动显示'}}"
    action-text="{{loadError ? '重新加载' : '查看历史事件'}}"
    bind:action="handleEmptyAction"
  />
</view>
