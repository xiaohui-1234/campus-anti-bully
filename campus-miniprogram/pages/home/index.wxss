.home-page {
  background:
    radial-gradient(circle at 92% 4%, rgba(185, 224, 225, 0.25), transparent 230rpx),
    #edf2f3;
}

.home-header {
  min-height: 142rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.home-header > view:first-child,
.header-badge {
  position: relative;
  z-index: 1;
}

.home-heading-shield {
  position: absolute;
  width: 250rpx;
  height: 194rpx;
  right: -12rpx;
  top: -20rpx;
  opacity: 0.58;
}

.header-badge {
  margin-top: 16rpx;
  height: 52rpx;
  border-radius: 26rpx;
  padding: 0 20rpx;
  background: #e7f4ed;
  color: #2f7d57;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  flex: 0 0 auto;
  gap: 8rpx;
}

.badge-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 50%;
  background: #58b37b;
}

.hero {
  position: relative;
  overflow: hidden;
  min-height: 230rpx;
  background: linear-gradient(135deg, #5a999d 0%, #367f89 100%);
  border-radius: 32rpx;
  padding: 34rpx;
  color: #ffffff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-sizing: border-box;
  margin-bottom: 24rpx;
  box-shadow: 0 20rpx 44rpx rgba(49, 116, 124, 0.2);
}

.hero::before,
.hero::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero::before {
  width: 300rpx;
  height: 300rpx;
  right: -140rpx;
  top: -190rpx;
}

.hero::after {
  width: 230rpx;
  height: 230rpx;
  right: 50rpx;
  bottom: -190rpx;
}

.hero > view {
  position: relative;
  z-index: 1;
}

.hero-kicker {
  font-size: 25rpx;
  opacity: 0.86;
}

.hero-title {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.9;
}

.hero-status {
  height: 58rpx;
  border-radius: 29rpx;
  padding: 0 20rpx;
  background: rgba(255, 255, 255, 0.16);
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
}

.pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #b9f6d0;
}

.hero-status.connecting .pulse {
  background: #ffe59a;
}

.hero-status.offline {
  background: rgba(74, 31, 31, 0.2);
}

.hero-status.offline .pulse {
  background: #ffc2bd;
}

.summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.summary-item {
  position: relative;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 26rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
  border: 1rpx solid #eef3f2;
}

.summary-mark {
  width: 52rpx;
  height: 52rpx;
  border-radius: 17rpx;
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.summary-mark.bind {
  background: #e8f4f3;
}

.summary-mark.event {
  background: #fff0ee;
}

.summary-mark image {
  width: 32rpx;
  height: 32rpx;
}

.num {
  font-size: 42rpx;
  font-weight: 800;
  color: #1d2b2f;
}

.label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7c8b8d;
}

.quick-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.quick-action {
  min-height: 92rpx;
  border-radius: 25rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #607477;
  font-size: 23rpx;
  font-weight: 600;
  box-shadow: 0 14rpx 34rpx rgba(35, 59, 65, 0.09);
  border: 1rpx solid #eef3f2;
}

.quick-action image {
  width: 34rpx;
  height: 34rpx;
}
