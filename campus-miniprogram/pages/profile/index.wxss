.profile-page {
  background:
    radial-gradient(circle at 92% 4%, rgba(185, 224, 225, 0.25), transparent 230rpx),
    #edf2f3;
}

.profile-heading {
  min-height: 142rpx;
  position: relative;
  overflow: hidden;
}

.profile-heading .page-title,
.profile-heading .page-subtitle {
  position: relative;
  z-index: 1;
}

.heading-shield {
  position: absolute;
  width: 250rpx;
  height: 194rpx;
  right: -12rpx;
  top: -20rpx;
  opacity: 0.58;
}

.profile-card {
  position: relative;
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
  min-height: 208rpx;
  background: linear-gradient(135deg, #5a999d 0%, #367f89 100%);
  border-radius: 32rpx;
  padding: 30rpx 32rpx;
  box-sizing: border-box;
  color: #ffffff;
  box-shadow: 0 20rpx 44rpx rgba(49, 116, 124, 0.2);
  overflow: hidden;
}

.profile-card-glow {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.profile-card-glow.one {
  width: 310rpx;
  height: 310rpx;
  right: -150rpx;
  top: -190rpx;
}

.profile-card-glow.two {
  width: 220rpx;
  height: 220rpx;
  right: 40rpx;
  bottom: -180rpx;
}

.avatar-wrap {
  position: relative;
  flex: 0 0 auto;
  z-index: 1;
}

.avatar {
  width: 132rpx;
  height: 132rpx;
  border-radius: 66rpx;
  background: rgba(255, 255, 255, 0.24);
  border: 7rpx solid rgba(255, 255, 255, 0.94);
  box-sizing: border-box;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
}

.avatar-status {
  position: absolute;
  right: -2rpx;
  bottom: 4rpx;
  width: 36rpx;
  height: 36rpx;
  padding: 2rpx;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.avatar-status image {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-pill {
  max-width: 100%;
  height: 46rpx;
  margin-top: 10rpx;
  padding: 0 14rpx 0 9rpx;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.14);
  display: inline-flex;
  align-items: center;
  gap: 5rpx;
  box-sizing: border-box;
  color: rgba(255, 255, 255, 0.92);
  font-size: 23rpx;
}

.role-pill image {
  width: 28rpx;
  height: 28rpx;
  flex: 0 0 auto;
}

.user-id {
  margin-top: 12rpx;
  max-width: 400rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.form-card {
  border-radius: 30rpx;
  padding: 26rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
}

.card-title {
  display: flex;
  align-items: center;
  gap: 13rpx;
  color: #26373b;
  font-size: 30rpx;
  font-weight: 800;
}

.card-title image {
  width: 34rpx;
  height: 34rpx;
}

.form-sheet {
  margin-top: 22rpx;
  padding: 0 18rpx;
  border: 1rpx solid #e7eeee;
  border-radius: 23rpx;
  background: rgba(255, 255, 255, 0.78);
}

.form-row {
  min-height: 88rpx;
  display: grid;
  grid-template-columns: 40rpx 126rpx 1fr;
  gap: 12rpx;
  align-items: center;
  border-bottom: 1rpx solid #edf1f1;
}

.form-row:last-child {
  border-bottom: 0;
}

.form-row-icon {
  width: 32rpx;
  height: 32rpx;
}

.form-label {
  color: #66767a;
  font-size: 27rpx;
}

.form-value {
  width: 100%;
  height: 72rpx;
  color: #44565a;
  font-size: 26rpx;
  text-align: right;
}

.form-placeholder {
  color: #a0aaad;
}

.profile-save {
  height: 72rpx;
  margin-top: 20rpx;
  border-radius: 22rpx;
  background: #edf5f2;
  color: #5aaa7b;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 11rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.profile-save.dirty {
  background: #0f8b8d;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(15, 139, 141, 0.18);
}

.profile-save image {
  width: 31rpx;
  height: 31rpx;
}

.action-list {
  margin-top: 24rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
}

.action-item {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid #e9eeee;
  color: #263238;
  font-size: 27rpx;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-main,
.action-side {
  display: flex;
  align-items: center;
}

.action-main {
  gap: 16rpx;
  flex: 0 0 auto;
  font-weight: 600;
}

.action-icon {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 auto;
}

.action-side {
  min-width: 0;
  flex: 1;
  justify-content: flex-end;
  gap: 12rpx;
  color: #96a1a4;
  font-size: 23rpx;
}

.action-side text:first-child {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  color: #9da8aa;
  font-size: 38rpx;
  line-height: 1;
  flex: 0 0 auto;
}

.danger-text .action-main {
  color: #d9564d;
}
