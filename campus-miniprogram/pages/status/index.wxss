.status-page {
  background:
    radial-gradient(circle at 92% 4%, rgba(185, 224, 225, 0.25), transparent 230rpx),
    #edf2f3;
}

.page-heading {
  min-height: 142rpx;
  position: relative;
  overflow: hidden;
}

.page-heading .page-title,
.page-heading .page-subtitle {
  position: relative;
  z-index: 1;
}

.heading-shield {
  position: absolute;
  width: 250rpx;
  height: 194rpx;
  right: -12rpx;
  top: -20rpx;
  opacity: 0.58;
}

.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat {
  background: #ffffff;
  border-radius: 28rpx;
  min-height: 200rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
  border: 1rpx solid #eef3f2;
}

.stat-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e8f4f3;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon.online {
  background: #e7f4ed;
}

.stat-icon.today {
  background: #fff6e8;
}

.stat-icon.unread {
  background: #fff0ee;
}

.stat-icon image {
  width: 35rpx;
  height: 35rpx;
}

.num {
  font-size: 52rpx;
  font-weight: 800;
  color: #1d2b2f;
}

.label {
  margin-top: 10rpx;
  color: #7c8b8d;
  font-size: 26rpx;
}

.status-note {
  margin-top: 24rpx;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 42rpx rgba(35, 59, 65, 0.105);
}

.note-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #1d2b2f;
}

.note-title image {
  width: 34rpx;
  height: 34rpx;
}

.note-text {
  margin-top: 12rpx;
  color: #6f7f82;
  font-size: 26rpx;
  line-height: 1.65;
}
